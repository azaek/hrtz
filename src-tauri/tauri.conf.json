{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hrtz",
  "mainBinaryName": "hrtz",
  "version": "0.2.0",
  "identifier": "com.azaek.hrtz",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hrtz",
        "decorations": false,
        "width": 1080,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNUE5Njk3NjRCN0QyNkEKUldScTByZGtsNVphb2o5Snc4KzRDekRZSjhxdUhhYlY0RzhvUWNMTUFYSW5xYXBRaVB6TUp1eVoK",
      "endpoints": [
        "https://github.com/azaek/hrtz/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
